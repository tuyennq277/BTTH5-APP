{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'fullName', 'email', 'createdAt'])",
        "uid": {
          ".validate": "newData.val() === $uid"
        },
        "fullName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().beginsWith('https://')"
        },
        "connections": {
          "$connection": {
            ".validate": "newData.val() === true"
          }
        },
        "lastOnline": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && newData.val() === true && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && root.child('chats').child($chatId).child('members').child($uid).val() === true",
          ".validate": "newData.val() === true"
        }
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).val() === true)",
        ".write": "auth != null && !data.exists() && newData.hasChildren(['members', 'user1', 'user2']) && newData.child('members').child(auth.uid).val() === true && !newData.hasChild('messages') && !newData.hasChild('readReceipts')",
        ".validate": "newData.hasChildren(['members', 'user1', 'user2']) && newData.child('user1').val() !== newData.child('user2').val() && newData.child('members').child(newData.child('user1').val()).val() === true && newData.child('members').child(newData.child('user2').val()).val() === true",
        "members": {
          "$uid": {
            ".validate": "newData.val() === true && root.child('users').child($uid).exists() && ($uid === newData.parent().parent().child('user1').val() || $uid === newData.parent().parent().child('user2').val())"
          }
        },
        "messages": {
          ".indexOn": ["createdAt"],
          "$messageId": {
            ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt'])",
            "senderId": {
              ".validate": "newData.val() === auth.uid"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 4000 && newData.val().replace(' ', '').replace('\\n', '').replace('\\r', '').replace('\\t', '').length > 0"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "readReceipts": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child($uid).val() === true && newData.exists()",
            ".validate": "newData.isString() && root.child('chats').child($chatId).child('messages').child(newData.val()).exists()"
          }
        },
        "$other": {
          ".validate": false
        },
        "user1": {
          ".validate": "newData.isString()"
        },
        "user2": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
